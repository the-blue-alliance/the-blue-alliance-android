## Copy this file to local.properties and edit as needed.
## local.properties is gitignored — safe to put secrets here.
## You only need this file if you want to override the defaults;
## the app builds and runs against the local Docker backend without it.

# API key for debug builds. "tba-dev-key" works with the local Docker
# backend. For production, get a real key at
# https://www.thebluealliance.com/account.
tba.api.key.debug=tba-dev-key

# By default debug builds hit the local Docker backend at
# http://10.0.2.2:8080/ (the emulator's alias for the host's localhost).
# Uncomment to hit production instead.
#tba.url.debug=https://www.thebluealliance.com/

# Debug builds point Firebase Auth at the local emulator (10.0.2.2:9099) and sign in a
# fake user instead of running the real sign-in flow. Set to false to exercise the real
# flow — the only way to try the metavr flavor's AppAuth browser sign-in in a debug build.
#tba.auth.emulator=false

# Google OAuth client for the metavr (Meta Horizon) flavor's browser sign-in. Needs an
# installed-app ("iOS") OAuth client in the same Google Cloud project as Firebase, because
# that is the client type whose redirect URI is its own id reversed — which is what AppAuth
# registers. Blank means sign-in reports that it isn't available rather than opening a
# browser that can't succeed.
#tba.oauth.client.id.metavr=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
