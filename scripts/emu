#!/usr/bin/env python3
"""emu — Android emulator automation CLI for use with Claude Code.

Subcommands:
  screenshot [path]          Capture screenshot (default: screenshot.png)
  find <text> [--raw]        Find UI elements matching text/content-desc
  tap <text>                 Tap element matching text/content-desc (must be unique)
  tap-xy <x> <y>            Tap at exact device pixel coordinates
  hover <text> | <x> <y>     Park a hovering stylus over an element/coordinate
                             (--shot PATH captures while it is hovering)
  hover --clear              Release a pointer left by a previous `hover`
  mouse move <text> | <x> <y> [--shot PATH]
                             Park a real (virtual USB) mouse pointer there; the
                             pointer and its icon (hand, I-beam) show in shots
  mouse click <text> | <x> <y> [--right|--middle] [--double] [--shot PATH]
  mouse scroll up|down|left|right [N] [--at <text> | --at <x> <y>]
                             Turn the wheel N notches (left/right: horizontal wheel)
  mouse drag <x1> <y1> <x2> <y2>
                             Left-button drag
  mouse pos | cursor | stop  Pointer position / icon type (HAND, TEXT, ARROW…) /
                             unregister (also `mouse --clear`)
  key <combo>...             Press keys in order: tab, esc, enter, ctrl+f,
                             shift+tab, meta+slash, KEYCODE_SEARCH, …
  logcat [options]           Show recent logcat lines
  back                       Press BACK key
  launch <package/activity>  Force-stop + start activity
  swipe <left|right>         Swipe home screen page
  swipe-xy <x1> <y1> <x2> <y2> [ms]  Swipe between coordinates
  long-press <text> | <x> <y> [ms]
                             Long press an element or coordinate (default 2000ms)
  top                        Print the resumed (foreground) activity and its task
  qs [--close]               Expand (or collapse) the Quick Settings panel
  list [--raw]               Dump UI hierarchy as readable tree

All reported and accepted coordinates are physical display pixels — the space
`input tap` and screenshots use — so a center printed by `find`/`list` can be
handed straight to `tap-xy`. On the Meta Spatial Simulator, where the spatial
shell composites each app window as a scaled, off-centre panel, that means
converting uiautomator's logical bounds; see the panel transform notes below.
Under a `wm size` override they are the overridden (letterboxed) display's
pixels, as in screenshots; hover and mouse map them onto the panel themselves.

hover vs mouse: `hover` is a stylus — enough for hover highlights, and it is
what a Quest laser pointer looks like. Use `mouse` for anything mouse-only:
pointer icons, right-click, middle-click, wheel. Each releases the other, so
only one pointer is ever drawn. Both stay registered between commands (the
mouse until `mouse stop`), keyed by serial, so they need -s / $ANDROID_SERIAL
when more than one device is attached.
"""

import argparse
import json
import os
import re
import signal
import socket
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET

BOUNDS_RE = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")

# Global serial; set by --serial / -s flag in main().
_serial = None


def adb(*args):
    """Run an adb command and return CompletedProcess."""
    cmd = ["adb"]
    if _serial:
        cmd += ["-s", _serial]
    cmd += list(args)
    return subprocess.run(cmd, capture_output=True, text=True)


def adb_check(*args):
    """Run an adb command; exit on failure."""
    result = adb(*args)
    if result.returncode != 0:
        print(f"adb error: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return result


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def require_serial():
    """Pin _serial: -s, else $ANDROID_SERIAL, else the only attached device.

    Commands that leave state on a device (hover, mouse) key their pid/socket
    files by serial, and must never guess between several devices.
    """
    global _serial
    if _serial:
        return _serial
    out = subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout
    devices = [l.split()[0] for l in out.splitlines()[1:] if l.strip().endswith("\tdevice")]
    if len(devices) != 1:
        die(f"{len(devices)} devices attached; pass -s SERIAL or set $ANDROID_SERIAL")
    _serial = devices[0]
    return _serial


def state_base(kind, serial):
    """Per-serial path prefix for state files that outlive one emu invocation."""
    d = tempfile.gettempdir()
    # AF_UNIX socket paths max out at 104 bytes on macOS.
    if len(d) > 60:
        d = "/tmp"
    return os.path.join(d, f"emu-{kind}-{re.sub(r'[^A-Za-z0-9._-]', '_', serial)}")


def parse_bounds(bounds_str):
    """Parse '[x1,y1][x2,y2]' → (x1, y1, x2, y2, cx, cy)."""
    m = BOUNDS_RE.match(bounds_str)
    if not m:
        return None
    x1, y1, x2, y2 = int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
    cx, cy = (x1 + x2) // 2, (y1 + y2) // 2
    return x1, y1, x2, y2, cx, cy


# ── Panel (Spatial Simulator) coordinate transform ───────────────────
#
# On the Meta Spatial Simulator (Horizon OS) apps are not drawn fullscreen. The
# spatial shell composites each app window as a *panel* — a scaled, usually
# off-centre rectangle somewhere on the physical display. `uiautomator dump`
# keeps reporting bounds in the window's own logical space, but `input tap`
# injects in physical display pixels, so raw uiautomator centers land nowhere
# near the element.
#
# It is not a multi-display problem: `dumpsys display` shows only the built-in
# screen plus an idle MirrorRoot virtual display, and `dumpsys input` reports a
# single viewport with FocusedDisplayId=0 — so `input -d <id>` has nothing to
# target. What differs is the per-window logical->screen transform SurfaceFlinger
# applies, which its dump spells out for every composited layer:
#
#   - Output Layer 0x..(com.example/com.example.MainActivity#42)
#       ... displayFrame=[l t r b] sourceCrop=[l t r b] ...
#
# sourceCrop is the slice of the window's buffer being sampled, sized in that
# window's logical pixels; displayFrame is where it lands on the physical
# display. uiautomator reports bounds relative to the window's own logical
# origin, so anchoring on that origin gives
#   screen = displayFrame.origin + (logical - windowOrigin) * scale
# with scale = displayFrame.size / sourceCrop.size.
#
# Worked example — The Blue Alliance on the simulator:
#   displayFrame=[103 524 1961 1685]  sourceCrop=[0 0 1280 800]
#   window logical bounds [103,523][1383,1323]  (1280x800, i.e. the whole crop)
#   scale = 1858/1280, 1161/800 → the "Sign in with Google" button moves from
#   logical (743, 971) to physical (1032, 1174), which is where it is on screen.
#
# The correction is applied when *reporting* bounds (find/list/tap all then speak
# physical pixels, matching screenshots), never when injecting. Injection stays a
# plain `input tap/swipe`, so on phones — where the whole path is skipped, since
# they report displayFrame == sourceCrop for the focused app window — the adb
# commands are byte-for-byte what they have always been.

LAYER_RE = re.compile(r"Output Layer 0x[0-9a-f]+\((.+)#\d+\)")
GEOMETRY_RE = re.compile(
    r"displayFrame=\[(-?\d+) (-?\d+) (-?\d+) (-?\d+)\]"
    r"\s+sourceCrop=\[(-?[\d.]+) (-?[\d.]+) (-?[\d.]+) (-?[\d.]+)\]"
)
IDENTITY = (1.0, 1.0, 0.0, 0.0)

# Cached `ro.product.name` probe; None until first queried.
_is_panel_device = None


def is_panel_device():
    """True on the Meta Spatial Simulator, where windows are composited as panels."""
    global _is_panel_device
    if _is_panel_device is None:
        name = adb("shell", "getprop", "ro.product.name").stdout.strip()
        _is_panel_device = "spatialsim" in name
    return _is_panel_device


def panel_layers():
    """Map package name → [(crop_w, crop_h, scale_x, scale_y, frame_x, frame_y)].

    One entry per composited layer, read out of `dumpsys SurfaceFlinger`.
    """
    result = adb("shell", "dumpsys", "SurfaceFlinger")
    if result.returncode != 0:
        print(f"warning: dumpsys SurfaceFlinger failed: {result.stderr.strip()}", file=sys.stderr)
        return {}

    layers = {}
    package = None
    for line in result.stdout.splitlines():
        m = LAYER_RE.search(line)
        if m:
            # Layer names are "<package>/<activity>", sometimes prefixed "VRI-".
            # Anything without a package (Wallpaper, StatusBar, …) is not a window
            # a uiautomator subtree can be matched onto.
            package = m.group(1).removeprefix("VRI-").split("/")[0]
            continue
        if package is None:
            continue
        m = GEOMETRY_RE.search(line)
        if m:
            dl, dt, dr, db = (int(v) for v in m.group(1, 2, 3, 4))
            cl, ct, cr, cb = (float(v) for v in m.group(5, 6, 7, 8))
            crop_w, crop_h = cr - cl, cb - ct
            if crop_w > 0 and crop_h > 0:
                layers.setdefault(package, []).append(
                    (crop_w, crop_h, (dr - dl) / crop_w, (db - dt) / crop_h, dl, dt)
                )
            package = None
    return layers


def window_transform(layers, window):
    """Affine (scale_x, scale_y, offset_x, offset_y) for one top-level window.

    Returns None when the window can't be matched to a composited layer, in
    which case its bounds are left alone rather than mangled.
    """
    candidates = layers.get(window.get("package", ""))
    bounds = parse_bounds(window.get("bounds", ""))
    if not candidates or not bounds:
        return None
    width, height = bounds[2] - bounds[0], bounds[3] - bounds[1]
    # A package can own several layers (dialogs, popups). uiautomator reports the
    # window at its logical size, which is exactly the region SurfaceFlinger
    # samples, so the crop size both picks the right layer and confirms the pair.
    crop_w, crop_h, sx, sy, dl, dt = min(
        candidates, key=lambda c: abs(c[0] - width) + abs(c[1] - height)
    )
    if abs(crop_w - width) > 1 or abs(crop_h - height) > 1:
        return None
    return sx, sy, dl - bounds[0] * sx, dt - bounds[1] * sy


def retag_bounds(elem, transform):
    """Rewrite bounds on elem and all descendants from logical to physical pixels."""
    sx, sy, ox, oy = transform
    for node in elem.iter():
        b = parse_bounds(node.get("bounds", ""))
        if not b:
            continue
        node.set("bounds", "[{},{}][{},{}]".format(
            round(b[0] * sx + ox), round(b[1] * sy + oy),
            round(b[2] * sx + ox), round(b[3] * sy + oy),
        ))


def apply_panel_transform(root):
    """Map every window in the hierarchy from logical into physical display pixels."""
    layers = panel_layers()
    if not layers:
        return
    for window in root:
        transform = window_transform(layers, window)
        if transform is not None and transform != IDENTITY:
            retag_bounds(window, transform)


def dump_ui_tree(raw=False):
    """Dump UI hierarchy XML from device and return parsed ElementTree root.

    Bounds come back in physical display pixels — the space `input tap` and
    screenshots use. Pass raw=True for the unconverted uiautomator (logical)
    bounds, which only differ on a panel device.
    """
    device_path = "/sdcard/window_dump.xml"
    adb_check("shell", "uiautomator", "dump", device_path)

    tmpdir = tempfile.mkdtemp()
    local_path = os.path.join(tmpdir, "window_dump.xml")
    adb_check("pull", device_path, local_path)

    tree = ET.parse(local_path)
    os.unlink(local_path)
    os.rmdir(tmpdir)
    root = tree.getroot()
    if not raw and is_panel_device():
        apply_panel_transform(root)
    return root


def display_size():
    """Physical display size as (width, height), honouring any `wm size` override."""
    out = adb_check("shell", "wm", "size").stdout
    m = re.search(r"Override size:\s*(\d+)x(\d+)", out) or re.search(r"Physical size:\s*(\d+)x(\d+)", out)
    if not m:
        print(f"Could not parse display size from: {out.strip()}", file=sys.stderr)
        sys.exit(1)
    return int(m.group(1)), int(m.group(2))


def find_elements(root, query):
    """Find elements whose text or content-desc contains query (case-insensitive)."""
    query_lower = query.lower()
    matches = []
    for elem in root.iter():
        text = elem.get("text", "")
        desc = elem.get("content-desc", "")
        if query_lower in text.lower() or query_lower in desc.lower():
            bounds_str = elem.get("bounds", "")
            bounds = parse_bounds(bounds_str)
            matches.append({
                "text": text,
                "content-desc": desc,
                "class": elem.get("class", ""),
                "resource-id": elem.get("resource-id", ""),
                "bounds": bounds_str,
                "center": (bounds[4], bounds[5]) if bounds else None,
            })
    return matches


def print_match(m, idx=None):
    """Print a single match result."""
    prefix = f"  [{idx}] " if idx is not None else "  "
    parts = []
    if m["text"]:
        parts.append(f'text="{m["text"]}"')
    if m["content-desc"]:
        parts.append(f'desc="{m["content-desc"]}"')
    if m["resource-id"]:
        parts.append(f'id="{m["resource-id"]}"')
    parts.append(f'class={m["class"]}')
    parts.append(f'bounds={m["bounds"]}')
    if m["center"]:
        parts.append(f"center=({m['center'][0]}, {m['center'][1]})")
    print(prefix + "  ".join(parts))


# ── Display viewport (wm size overrides) ─────────────────────────────
#
# With a `wm size` override the logical display is scaled and letterboxed into
# the panel: 1080x1600 on a 1080x2400 phone is drawn at physicalFrame
# [0, 400, 1080, 2000]. Screenshots, `input tap`, uiautomator and the app all
# speak logical pixels, but the input pipeline doesn't: a mouse position in
# `dumpsys input` is in the physical frame, and a direct (stylus) device's axes
# span the whole physical panel. These map between the two; without an override
# the frames are equal and both are the identity. Natural orientation only.

FRAME_RE = r"\[(-?\d+), (-?\d+), (-?\d+), (-?\d+)\]"
VIEWPORT_RE = re.compile(
    rf"Viewport INTERNAL: displayId=0,[^\n]*?logicalFrame={FRAME_RE}, "
    rf"physicalFrame={FRAME_RE}, deviceSize=\[(\d+), (\d+)\]")


def parse_viewport(dump):
    """(logicalFrame, physicalFrame, deviceSize) of display 0 from `dumpsys input`, or None."""
    m = VIEWPORT_RE.search(dump)
    if not m:
        return None
    v = [int(g) for g in m.groups()]
    if v[2] <= v[0] or v[3] <= v[1] or v[6] <= v[4] or v[7] <= v[5]:
        return None
    return v[0:4], v[4:8], v[8:10]


def to_logical(pos, logical, physical):
    """Physical-panel px → logical display px."""
    sx = (logical[2] - logical[0]) / (physical[2] - physical[0])
    sy = (logical[3] - logical[1]) / (physical[3] - physical[1])
    return logical[0] + (pos[0] - physical[0]) * sx, logical[1] + (pos[1] - physical[1]) * sy


def to_physical(pos, logical, physical):
    """Logical display px → physical-panel px (inverse of to_logical)."""
    return to_logical(pos, physical, logical)


# ── Hover injection ──────────────────────────────────────────────────
#
# `input` cannot inject hover: its motionevent verb only accepts
# DOWN|UP|MOVE|CANCEL, so there is no way to produce ACTION_HOVER_MOVE with it.
# Hover matters because a Quest's laser pointer hovers constantly, and because
# mouse and trackpad users see the same states — so hover regressions need to be
# reproducible and screenshottable.
#
# Instead we register a virtual absolute-positioning stylus over /dev/uinput, via
# the platform's `uinput` shell tool (which `shell` may use: it is in the `uhid`
# group). A pen reporting BTN_TOOL_PEN *without* BTN_TOUCH is hovering — the
# kernel and InputReader turn that into ACTION_HOVER_ENTER/MOVE. Declaring
# INPUT_PROP_DIRECT maps its ABS range 1:1 onto the physical panel; hover_at maps
# its target there (see parse_viewport), so the coordinates this command takes
# are the same display pixels `tap-xy` uses and `find`/`list` report, under a
# `wm size` override too, and on a Spatial Simulator where the panel transform
# above has already been applied.
#
# The virtual device lives exactly as long as the `uinput` process holds it open,
# so the hover has to outlive this command for a screenshot to catch it: we send
# a trailing `delay` and leave the child running detached, recording its pid so a
# later call can release it.

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
ABS_X, ABS_Y = 0, 1
BTN_TOUCH, BTN_TOOL_PEN = 330, 320
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 100, 101, 103, 110
INPUT_PROP_DIRECT = 0



def _abs_axis(code, maximum):
    return {"code": code, "info": {"value": 0, "minimum": 0, "maximum": maximum,
                                   "fuzz": 0, "flat": 0, "resolution": 0}}


def hover_pid_file():
    return state_base("hover", require_serial()) + ".pid"


def hover_release():
    """Kill the `uinput` child from a previous `hover`, if it is still alive."""
    try:
        with open(hover_pid_file()) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return False
    alive = True
    try:
        os.killpg(os.getpgid(pid), signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        alive = False
    try:
        os.remove(hover_pid_file())
    except OSError:
        pass
    return alive


def hover_at(x, y, hold):
    """Park a hovering stylus at (x, y) for `hold` seconds; return immediately."""
    width, height = display_size()
    if not (0 <= x < width and 0 <= y < height):
        print(f"({x}, {y}) is outside the {width}x{height} display", file=sys.stderr)
        sys.exit(1)
    # The stylus axes span the physical panel, so aim in panel pixels.
    viewport = parse_viewport(adb("shell", "dumpsys", "input").stdout)
    if viewport:
        (width, height) = viewport[2]
        x, y = (round(v) for v in to_physical((x, y), *viewport[:2]))

    script = [
        {"id": 1, "command": "register", "name": "emu-hover",
         "vid": 0x18d1, "pid": 0x4004, "bus": "usb",
         "configuration": [
             {"type": UI_SET_EVBIT, "data": [EV_KEY, EV_ABS]},
             {"type": UI_SET_KEYBIT, "data": [BTN_TOOL_PEN, BTN_TOUCH]},
             {"type": UI_SET_ABSBIT, "data": [ABS_X, ABS_Y]},
             {"type": UI_SET_PROPBIT, "data": [INPUT_PROP_DIRECT]},
         ],
         "abs_info": [_abs_axis(ABS_X, width - 1), _abs_axis(ABS_Y, height - 1)]},
        # Let InputReader notice the new device before addressing it.
        {"id": 1, "command": "delay", "duration": 500},
        # Pen in range but not touching == hover.
        {"id": 1, "command": "inject",
         "events": [EV_KEY, BTN_TOOL_PEN, 1,
                    EV_ABS, ABS_X, x,
                    EV_ABS, ABS_Y, y,
                    EV_SYN, 0, 0]},
        {"id": 1, "command": "delay", "duration": int(hold * 1000)},
    ]

    cmd = ["adb"] + (["-s", _serial] if _serial else []) + ["shell", "uinput", "-"]
    # start_new_session so the child outlives this process and can be signalled as
    # a group; stdin is closed so `uinput` runs the script straight through.
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, text=True, start_new_session=True)
    proc.stdin.write("\n".join(json.dumps(s) for s in script) + "\n")
    proc.stdin.flush()
    proc.stdin.close()

    with open(hover_pid_file(), "w") as f:
        f.write(str(proc.pid))

    # Cover registration plus the settle delay above, so that by the time this
    # returns the hover is on screen and ready to be captured.
    time.sleep(1.5)
    if proc.poll() is not None:
        print("uinput exited immediately — is /dev/uinput readable by shell?", file=sys.stderr)
        sys.exit(1)


# ── Mouse injection ──────────────────────────────────────────────────
#
# `hover` fakes a stylus, which is enough for hover highlights but is not a
# mouse: Compose only shows pointer icons (hand, I-beam) for mouse pointers, a
# stylus has no secondary button, and wheel handlers want mouse-source events.
# `mouse` registers a real relative USB mouse (buttons, wheel, horizontal wheel)
# through the same `uinput -` shell tool, no root needed.
#
# A uinput device lives only as long as its `uinput` process reads stdin, so a
# detached daemon (this script re-run as `--mouse-daemon SERIAL`) owns that
# process and forwards JSON lines from a per-serial Unix socket into it. A dead
# daemon leaves only a socket nobody listens on, which the next command notices
# and replaces, so there is nothing like a FIFO left to block on.
#
# A relative mouse cannot be told where to go, only how far to move. The pointer
# position is read back from `dumpsys input` (InputDispatcher's per-device
# "Pointer(id=0, MOUSE) at (x, y)") and the move repeated until it lands within
# MOUSE_TOLERANCE px. The gain (display px per count; ~2.7 on a 420dpi phone)
# is learned from each step rather than assumed. Positions are logical display
# pixels — the space of `input tap`, screenshots and `find` — including under a
# letterboxing `wm size` override (see parse_viewport).

EV_REL = 2
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL = 0, 1, 6, 8
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 272, 273, 274
UI_SET_RELBIT = 102
MOUSE_NAME = "emu-mouse"
MOUSE_TOLERANCE = 2.0

# android.view.PointerIcon TYPE_* constants, as dumped by MouseCursorController.
POINTER_ICONS = {
    -1: "CUSTOM", 0: "NULL", 1: "NOT_SPECIFIED", 1000: "ARROW", 1001: "CONTEXT_MENU",
    1002: "HAND", 1003: "HELP", 1004: "WAIT", 1006: "CELL", 1007: "CROSSHAIR",
    1008: "TEXT", 1009: "VERTICAL_TEXT", 1010: "ALIAS", 1011: "COPY", 1012: "NO_DROP",
    1013: "ALL_SCROLL", 1014: "HORIZONTAL_DOUBLE_ARROW", 1015: "VERTICAL_DOUBLE_ARROW",
    1016: "TOP_RIGHT_DIAGONAL_DOUBLE_ARROW", 1017: "TOP_LEFT_DIAGONAL_DOUBLE_ARROW",
    1018: "ZOOM_IN", 1019: "ZOOM_OUT", 1020: "GRAB", 1021: "GRABBING", 1022: "HANDWRITING",
}


def mouse_paths(serial):
    """(socket, pid, log) paths for serial's mouse daemon."""
    base = state_base("mouse", serial)
    return base + ".sock", base + ".pid", base + ".log"


def _daemon_alive(pid):
    """True if pid is a running `emu --mouse-daemon` (not some recycled pid)."""
    out = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True).stdout
    return "--mouse-daemon" in out


def mouse_daemon(serial):
    """Own one `uinput -` process for serial and feed it JSON lines from the socket."""
    sock_path, pid_path, _ = mouse_paths(serial)
    proc = subprocess.Popen(["adb", "-s", serial, "shell", "uinput", "-"],
                            stdin=subprocess.PIPE, text=True)

    def feed(obj):
        proc.stdin.write(json.dumps(obj) + "\n")
        proc.stdin.flush()

    feed({"id": 1, "command": "register", "name": MOUSE_NAME,
          "vid": 0x18d1, "pid": 0x4005, "bus": "usb",
          "configuration": [
              {"type": UI_SET_EVBIT, "data": [EV_KEY, EV_REL]},
              {"type": UI_SET_KEYBIT, "data": [BTN_LEFT, BTN_RIGHT, BTN_MIDDLE]},
              {"type": UI_SET_RELBIT, "data": [REL_X, REL_Y, REL_HWHEEL, REL_WHEEL]},
          ]})

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(sock_path)
    except OSError:
        pass
    srv.bind(sock_path)
    sock_ino = os.stat(sock_path).st_ino
    srv.listen(4)
    srv.settimeout(1.0)
    with open(pid_path, "w") as f:
        f.write(str(os.getpid()))
    try:
        while proc.poll() is None:
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            stop = False
            with conn:
                conn.settimeout(5)
                data = b""
                while chunk := conn.recv(65536):
                    data += chunk
                for line in data.decode().splitlines():
                    if not line.strip():
                        continue
                    msg = json.loads(line)
                    if msg.get("command") == "stop":
                        stop = True
                        break
                    feed(msg)
                conn.sendall(b"ok\n")
            if stop:
                break
    finally:
        # EOF on stdin makes uinput exit, which unregisters the device.
        try:
            proc.stdin.close()
            proc.wait(timeout=3)
        except Exception:
            proc.kill()
        # A daemon that was signalled late (e.g. after being stopped) can outlive
        # its replacement; only remove files that are still this daemon's own.
        try:
            if os.stat(sock_path).st_ino == sock_ino:
                os.unlink(sock_path)
            with open(pid_path) as f:
                if f.read().strip() == str(os.getpid()):
                    os.unlink(pid_path)
        except OSError:
            pass


def _mouse_connect(sock_path):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(sock_path)
    return s


def _mouse_deliver(sock_path, msgs):
    s = _mouse_connect(sock_path)
    with s:
        s.sendall(("\n".join(json.dumps(m) for m in msgs) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        reply = s.recv(16)
    if reply != b"ok\n":
        # The daemon died mid-request; OSError makes mouse_send restart it.
        raise OSError(f"mouse daemon replied {reply!r}")


def mouse_device_id():
    """InputReader id of this serial's mouse, or None if it isn't registered."""
    out = adb_check("shell", "dumpsys", "input").stdout
    m = re.search(rf"^\s*Device (\d+): {MOUSE_NAME}$", out, re.M)
    return int(m.group(1)) if m else None


def mouse_start():
    """Start the mouse daemon for _serial and wait for the device to register."""
    sock_path, pid_path, log_path = mouse_paths(_serial)
    mouse_stop()  # clear anything stale left by a crashed daemon
    hover_release()  # a parked stylus would keep hovering its own target
    with open(log_path, "w") as log:
        daemon = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--mouse-daemon", _serial],
                                  stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                  start_new_session=True)
    deadline = time.time() + 10
    while time.time() < deadline:
        if os.path.exists(sock_path) and mouse_device_id() is not None:
            # Let InputReader finish configuring the device before it is addressed.
            time.sleep(0.3)
            return
        time.sleep(0.25)
    with open(log_path) as f:
        detail = f.read().strip()
    daemon.terminate()
    mouse_stop()
    die(f"virtual mouse didn't register within 10s{': ' + detail if detail else ''}")


def mouse_send(*msgs):
    """Inject uinput messages through the mouse, starting it on first use."""
    sock_path, _, _ = mouse_paths(_serial)
    try:
        _mouse_deliver(sock_path, msgs)
    except OSError:
        mouse_start()
        _mouse_deliver(sock_path, msgs)


def mouse_stop():
    """Unregister this serial's mouse; True if one was running."""
    sock_path, pid_path, log_path = mouse_paths(_serial)
    stopped = False
    try:
        _mouse_deliver(sock_path, [{"command": "stop"}])
        stopped = True
    except OSError:
        pass
    try:
        with open(pid_path) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        pid = None
    # A daemon that took the stop request gets a moment to unregister the device;
    # one whose socket is unreachable is wedged, so signal it straight away.
    deadline = time.time() + (3 if stopped else 0)
    while pid and _daemon_alive(pid):
        if time.time() >= deadline:
            try:
                os.kill(pid, signal.SIGTERM)
                stopped = True
            except ProcessLookupError:
                pass
            time.sleep(0.5)
            break
        time.sleep(0.1)
    for path in (sock_path, pid_path, log_path):
        try:
            os.unlink(path)
        except OSError:
            pass
    return stopped


def _inject(*events):
    return {"id": 1, "command": "inject", "events": list(events) + [EV_SYN, 0, 0]}


def _delay(ms):
    return {"id": 1, "command": "delay", "duration": ms}


def parse_mouse_pos(dump, device_id):
    """Pointer (x, y) for device_id in a `dumpsys input` dump, or None.

    InputDispatcher prints one "DeviceId(N):[... Pointer(id=0, MOUSE) at (x, y)]"
    line per window the pointer is over; entries for unplugged devices linger, so
    the id has to match.
    """
    m = re.search(rf"DeviceId\({device_id}\):\[[^\n]*?MOUSE\) at \((-?[\d.]+), (-?[\d.]+)\)", dump)
    return (float(m.group(1)), float(m.group(2))) if m else None


def mouse_pos():
    """Pointer position in logical display px, or None if there is no mouse pointer."""
    out = adb_check("shell", "dumpsys", "input").stdout
    m = re.search(rf"^\s*Device (\d+): {MOUSE_NAME}$", out, re.M)
    pos = parse_mouse_pos(out, m.group(1)) if m else None
    viewport = parse_viewport(out)
    if pos and viewport:
        pos = to_logical(pos, *viewport[:2])
    return pos


def next_step(delta, gain):
    """Counts to cover delta px at gain px/count; 0 once within tolerance.

    Tolerance is MOUSE_TOLERANCE, or half a count when one count moves further
    than that (a scaled-down `wm size` override), since that is as close as a
    relative mouse can land.
    """
    if abs(delta) <= max(MOUSE_TOLERANCE, gain / 2):
        return 0
    return int(round(delta / gain)) or (1 if delta > 0 else -1)


def mouse_move_to(x, y, timeout=10.0):
    """Move the pointer to (x, y) display px, within MOUSE_TOLERANCE; returns where it landed."""
    width, height = display_size()
    if not (0 <= x < width and 0 <= y < height):
        die(f"({x}, {y}) is outside the {width}x{height} display")
    pos = mouse_pos()
    if pos is None:
        # A freshly registered pointer has no position until it first moves.
        mouse_send(_inject(EV_REL, REL_X, 1))
        time.sleep(0.2)
        pos = mouse_pos()
        if pos is None:
            die("can't read the mouse position from `dumpsys input`")
    gain = [2.5, 2.5]
    deadline = time.time() + timeout
    while True:
        dx, dy = x - pos[0], y - pos[1]
        sx, sy = next_step(dx, gain[0]), next_step(dy, gain[1])
        if sx == 0 and sy == 0:
            return pos
        if time.time() > deadline:
            die(f"pointer stuck at ({pos[0]:.0f}, {pos[1]:.0f}) after {timeout:.0f}s; wanted ({x}, {y})")
        mouse_send(_inject(EV_REL, REL_X, sx, EV_REL, REL_Y, sy))
        time.sleep(0.05)
        new = mouse_pos() or pos
        for axis, step in ((0, sx), (1, sy)):
            moved = new[axis] - pos[axis]
            # Motion is linear in counts (no acceleration for single events), so any
            # step that moved and wasn't clamped at an edge gives the gain.
            if step and 0.2 < moved / step < 20:
                gain[axis] = moved / step
        pos = new


def mouse_gain(pos):
    """Display px per count on each axis, measured with a small probe move from pos."""
    width, height = display_size()
    probe = 20
    sx = probe if pos[0] < width / 2 else -probe
    sy = probe if pos[1] < height / 2 else -probe
    mouse_send(_inject(EV_REL, REL_X, sx, EV_REL, REL_Y, sy))
    time.sleep(0.1)
    new = mouse_pos() or pos
    gx, gy = (new[0] - pos[0]) / sx, (new[1] - pos[1]) / sy
    if not (gx > 0 and gy > 0):
        die(f"couldn't measure pointer gain (probe moved {pos} → {new})")
    return gx, gy


def mouse_drag(start, end, steps):
    """Left-drag from start to end in `steps` moves; returns where the pointer ended.

    InputDispatcher stops reporting the position while a button is held, so the
    drag is dead-reckoned from a gain measured just before pressing.
    """
    width, height = display_size()
    for x, y in (start, end):
        if not (0 <= x < width and 0 <= y < height):
            die(f"({x}, {y}) is outside the {width}x{height} display")
    gain = mouse_gain(mouse_move_to(*start))
    origin = mouse_move_to(*start)
    mouse_send(_inject(EV_KEY, BTN_LEFT, 1))
    try:
        time.sleep(0.1)
        sent = [0, 0]
        for i in range(1, steps + 1):
            want = [round((start[a] + (end[a] - start[a]) * i / steps - origin[a]) / gain[a]) for a in (0, 1)]
            mouse_send(_inject(EV_REL, REL_X, want[0] - sent[0], EV_REL, REL_Y, want[1] - sent[1]))
            sent = want
            time.sleep(0.03)
        time.sleep(0.1)
    finally:
        mouse_send(_inject(EV_KEY, BTN_LEFT, 0))
    time.sleep(0.3)
    return mouse_pos() or end


def mouse_click(button, double=False):
    press = [_inject(EV_KEY, button, 1), _delay(50), _inject(EV_KEY, button, 0)]
    msgs = press + ([_delay(80)] + press if double else [])
    mouse_send(*msgs)
    time.sleep(0.4 if double else 0.2)


def pointer_icon():
    """(type, name) of the mouse pointer icon on the default display, or None."""
    out = adb_check("shell", "dumpsys", "input").stdout
    i = out.find("MouseCursorController")
    m = re.search(r"resolvedPointerType: (-?\d+)", out[i:]) if i >= 0 else None
    if not m:
        return None
    t = int(m.group(1))
    return t, POINTER_ICONS.get(t, "UNKNOWN")


# ── Key injection ────────────────────────────────────────────────────

KEY_MODIFIERS = {
    "ctrl": "CTRL_LEFT", "control": "CTRL_LEFT", "shift": "SHIFT_LEFT",
    "alt": "ALT_LEFT", "option": "ALT_LEFT",
    "meta": "META_LEFT", "cmd": "META_LEFT", "win": "META_LEFT", "super": "META_LEFT",
}
KEY_ALIASES = {
    "esc": "ESCAPE", "return": "ENTER", "backspace": "DEL", "bksp": "DEL",
    "delete": "FORWARD_DEL", "del": "FORWARD_DEL", "up": "DPAD_UP", "down": "DPAD_DOWN",
    "left": "DPAD_LEFT", "right": "DPAD_RIGHT", "pgup": "PAGE_UP", "pageup": "PAGE_UP",
    "pgdn": "PAGE_DOWN", "pagedown": "PAGE_DOWN", "home": "MOVE_HOME", "end": "MOVE_END",
    "/": "SLASH", ",": "COMMA", ".": "PERIOD", "-": "MINUS", "=": "EQUALS",
    ";": "SEMICOLON", "'": "APOSTROPHE", "[": "LEFT_BRACKET", "]": "RIGHT_BRACKET",
    "\\": "BACKSLASH", "`": "GRAVE",
}


def keycode(name):
    """KEYCODE_* for a key name: `tab`, `esc`, `f`, `5`, `slash`, `/`, `KEYCODE_SEARCH`."""
    low = name.lower()
    if low in KEY_MODIFIERS:
        code = KEY_MODIFIERS[low]
    elif name in KEY_ALIASES or low in KEY_ALIASES:
        code = KEY_ALIASES.get(name) or KEY_ALIASES[low]
    else:
        code = name.upper().removeprefix("KEYCODE_")
    if not re.fullmatch(r"[A-Z0-9_]+", code):
        raise ValueError(f"unknown key: {name!r}")
    return "KEYCODE_" + code


def parse_combo(combo):
    """`ctrl+shift+f` → ['KEYCODE_CTRL_LEFT', 'KEYCODE_SHIFT_LEFT', 'KEYCODE_F'].

    `+` alone or as the last key means the plus key (`ctrl++`).
    """
    if combo == "+":
        return ["KEYCODE_PLUS"]
    parts = combo.split("+")
    if combo.endswith("++"):
        parts = parts[:-2] + ["PLUS"]
    if any(p == "" for p in parts):
        raise ValueError(f"malformed combo: {combo!r}")
    return [keycode(p) for p in parts]


# ── Subcommand handlers ──────────────────────────────────────────────


def capture_screenshot(out_path):
    device_path = "/sdcard/screen.png"
    adb_check("shell", "screencap", "-p", device_path)
    adb_check("pull", device_path, out_path)
    print(f"Screenshot saved to {out_path}")


def cmd_screenshot(args):
    capture_screenshot(args.path)


def cmd_find(args):
    root = dump_ui_tree(raw=args.raw)
    matches = find_elements(root, args.text)
    if not matches:
        print(f"No elements matching \"{args.text}\"")
        sys.exit(1)
    print(f"Found {len(matches)} match(es) for \"{args.text}\":")
    for i, m in enumerate(matches):
        print_match(m, i)


def find_unique(query):
    """The one element matching query, with parseable bounds; exits listing candidates otherwise."""
    root = dump_ui_tree()
    matches = find_elements(root, query)
    if len(matches) == 0:
        print(f"No elements matching \"{query}\"", file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(f"Ambiguous: {len(matches)} elements match \"{query}\". Refine your query:", file=sys.stderr)
        for i, m in enumerate(matches):
            print_match(m, i)
        sys.exit(1)
    m = matches[0]
    if not m["center"]:
        print("Matched element has no parseable bounds", file=sys.stderr)
        sys.exit(1)
    return m


def is_int(s):
    return s.lstrip("-").isdigit()


def cmd_tap(args):
    m = find_unique(args.text)
    cx, cy = m["center"]
    adb_check("shell", "input", "tap", str(cx), str(cy))
    print(f"Tapped ({cx}, {cy})")
    print_match(m)


def cmd_tap_xy(args):
    adb_check("shell", "input", "tap", str(args.x), str(args.y))
    print(f"Tapped ({args.x}, {args.y})")


def resolve_target(target, y, verb):
    """(x, y, element-or-None) from `TEXT` or `X Y`; a number is x only when a y follows."""
    if target is None:
        die(f"{verb} needs an element query, or x and y")
    if y is not None:
        if not is_int(target):
            die(f"{verb} got a y but \"{target}\" is not an x coordinate")
        return int(target), y, None
    m = find_unique(target)
    return m["center"][0], m["center"][1], m


def cmd_hover(args):
    require_serial()
    if args.clear:
        print("Released hover pointer" if hover_release() else "No hover pointer to release")
        return

    # Any earlier pointer would keep hovering its own target and muddy the shot.
    hover_release()
    if mouse_stop():
        print("Stopped the virtual mouse (it would draw a second pointer)")

    x, y, described = resolve_target(args.target, args.y, "hover")
    hover_at(x, y, args.hold)
    print(f"Hovering ({x}, {y}) for {args.hold}s")
    if args.shot:
        capture_screenshot(args.shot)
    if described:
        print_match(described)


def _report(verb, pos, described, shot):
    print(f"{verb} at ({pos[0]:.0f}, {pos[1]:.0f})")
    if shot:
        capture_screenshot(shot)
    if described:
        print_match(described)


def cmd_mouse(args):
    require_serial()
    action = args.action
    if args.clear or action == "stop":
        print("Stopped the virtual mouse" if mouse_stop() else "No virtual mouse running")
        return
    if action is None:
        die("mouse needs an action: move, click, scroll, drag, pos, cursor, stop")

    if action == "pos":
        pos = mouse_pos()
        if pos is None:
            die("No virtual mouse pointer (it starts on the first move/click)")
        print(f"Pointer at ({pos[0]:.1f}, {pos[1]:.1f})")
    elif action == "cursor":
        icon = pointer_icon()
        if icon is None:
            die("No mouse pointer controller in `dumpsys input` (no mouse attached?)")
        print(f"{icon[1]} ({icon[0]})")
    elif action == "move":
        x, y, described = resolve_target(args.target, args.y, "mouse move")
        pos = mouse_move_to(x, y)
        time.sleep(0.3)  # let hover state and the pointer icon catch up before a shot
        _report("Pointer parked", pos, described, args.shot)
    elif action == "click":
        x, y, described = resolve_target(args.target, args.y, "mouse click")
        button = BTN_RIGHT if args.right else BTN_MIDDLE if args.middle else BTN_LEFT
        pos = mouse_move_to(x, y)
        mouse_click(button, args.double)
        if args.shot:
            time.sleep(1.0)  # menus and ripples animate in
        name = {BTN_LEFT: "Left", BTN_RIGHT: "Right", BTN_MIDDLE: "Middle"}[button]
        _report(f"{name}-{'double-' if args.double else ''}clicked", pos, described, args.shot)
    elif action == "scroll":
        if args.n < 1:
            die("mouse scroll needs at least 1 notch")
        if args.at:
            if len(args.at) > 2:
                die("mouse scroll --at takes TEXT or X Y")
            target = args.at[0]
            y = None
            if len(args.at) == 2:
                if not is_int(args.at[1]):
                    die(f"mouse scroll --at got \"{args.at[1]}\" where a y coordinate goes")
                y = int(args.at[1])
            x, y, _ = resolve_target(target, y, "mouse scroll --at")
            mouse_move_to(x, y)
        # Wheel up / right are positive, like evdev.
        axis, sign = {"up": (REL_WHEEL, 1), "down": (REL_WHEEL, -1),
                      "left": (REL_HWHEEL, -1), "right": (REL_HWHEEL, 1)}[args.direction]
        notches = []
        for _ in range(args.n):
            notches += [_inject(EV_REL, axis, sign), _delay(30)]
        mouse_send(*notches)
        time.sleep(0.05 * args.n + 0.4)
        print(f"Scrolled {args.direction} {args.n} notch(es)")
        if args.shot:
            capture_screenshot(args.shot)
    elif action == "drag":
        end = mouse_drag((args.x1, args.y1), (args.x2, args.y2), max(1, args.steps))
        print(f"Dragged ({args.x1}, {args.y1}) → ({end[0]:.0f}, {end[1]:.0f})")
        if args.shot:
            capture_screenshot(args.shot)


KNOWN_KEYS = {"TAB", "ENTER", "SPACE", "ESCAPE", "SEARCH", "MENU", "BACK", "HOME", "PLUS",
              "INSERT", "BREAK", "CAPS_LOCK", *KEY_MODIFIERS.values(), *KEY_ALIASES.values()}


def key_known(code):
    """True if `input` will understand code. `input keyevent` silently drops unknown
    names, so anything not obviously valid is checked against keycombination, which
    names the bad keycode (and otherwise only complains that one key is too few)."""
    name = code.removeprefix("KEYCODE_")
    if name in KNOWN_KEYS or re.fullmatch(r"[A-Z0-9]|F[1-9]|F1[0-2]|DPAD_(UP|DOWN|LEFT|RIGHT|CENTER)", name):
        return True
    out = adb("shell", "input", "keycombination", code)
    return "Unknown keycode" not in out.stdout + out.stderr


def cmd_key(args):
    combos = []
    for combo in args.combos:
        try:
            codes = parse_combo(combo)
        except ValueError as e:
            die(str(e))
        for code in codes:
            if not key_known(code):
                die(f"unknown key {code} in {combo!r} (see android.view.KeyEvent KEYCODE_*)")
        combos.append(codes)
    for codes in combos:
        if len(codes) == 1:
            adb_check("shell", "input", "keyevent", codes[0])
        else:
            adb_check("shell", "input", "keycombination", *codes)
        print(f"Pressed {' + '.join(c.removeprefix('KEYCODE_') for c in codes)}")


def cmd_logcat(args):
    # adb_check appends these after any `-s <serial>`, so logcat's own `-s <tag>`
    # filter doesn't collide with the device selector.
    logcat_args = ["logcat", "-d"]
    if args.tag:
        logcat_args += ["-s", args.tag]
    result = adb_check(*logcat_args)
    lines = result.stdout.splitlines()
    if args.grep:
        pattern = args.grep.lower()
        lines = [l for l in lines if pattern in l.lower()]
    lines = lines[-args.n:]
    print("\n".join(lines))


def cmd_back(args):
    adb_check("shell", "input", "keyevent", "KEYCODE_BACK")
    print("Pressed BACK")


def cmd_launch(args):
    pkg = args.component.split("/")[0]
    # Android 17+ gates the local-network dev backend (10.0.2.2) behind the dangerous
    # ACCESS_LOCAL_NETWORK permission; declaring it in the manifest isn't enough. Grant it
    # best-effort so the debug build can reach the local server. adb() captures output, so this
    # is a silent no-op on pre-17, when already granted, or when the build doesn't declare it.
    adb("shell", "pm", "grant", pkg, "android.permission.ACCESS_LOCAL_NETWORK")
    adb("shell", "am", "force-stop", pkg)
    adb_check("shell", "am", "start", "-n", args.component)
    print(f"Launched {args.component}")


def cmd_swipe(args):
    direction = args.direction.lower()
    # Derived from the display rather than hardcoded, so the gesture stays on
    # screen on a Spatial Simulator panel. The fractions reproduce the phone
    # values this command has always used (1080x2400 → x=270, y=800).
    width, height = display_size()
    far, near, y = str(width // 4), "10", str(height // 3)
    if direction == "left":
        adb_check("shell", "input", "swipe", far, y, near, y, "150")
        print("Swiped home page left")
    elif direction == "right":
        adb_check("shell", "input", "swipe", near, y, far, y, "150")
        print("Swiped home page right")
    else:
        print(f"Unknown direction: {direction}. Use 'left' or 'right'.", file=sys.stderr)
        sys.exit(1)


def cmd_swipe_xy(args):
    duration = str(args.ms) if args.ms else "200"
    adb_check("shell", "input", "swipe", str(args.x1), str(args.y1), str(args.x2), str(args.y2), duration)
    print(f"Swiped ({args.x1},{args.y1}) → ({args.x2},{args.y2}) in {duration}ms")


def cmd_long_press(args):
    # `long-press X Y [ms]` (as before) or `long-press TEXT [ms]`. As with hover, a number
    # is an x coordinate only when a y follows it; alone, it's searched as text.
    rest = args.rest
    if not all(is_int(r) for r in rest):
        print(f"long-press: expected integers after the target, got {' '.join(rest)}", file=sys.stderr)
        sys.exit(1)
    described = None
    if is_int(args.target) and rest:
        if len(rest) > 2:
            print("long-press with coordinates takes: x y [ms]", file=sys.stderr)
            sys.exit(1)
        x, y = int(args.target), int(rest[0])
        ms = rest[1] if len(rest) == 2 else None
    else:
        if len(rest) > 1:
            print("long-press with an element query takes: text [ms]", file=sys.stderr)
            sys.exit(1)
        described = find_unique(args.target)
        x, y = described["center"]
        ms = rest[0] if rest else None
    duration = int(ms) if ms else 2000
    adb_check("shell", "input", "touchscreen", "swipe", str(x), str(y), str(x), str(y), str(duration))
    print(f"Long-pressed ({x}, {y}) for {duration}ms")
    if described:
        print_match(described)


def cmd_top(args):
    out = adb_check("shell", "dumpsys", "activity", "activities").stdout
    # topResumedActivity on Android 10+; mResumedActivity on older releases.
    m = re.search(r"(?:topResumedActivity|mResumedActivity)=ActivityRecord\{\S+ u\d+ (\S+) t(-?\d+)", out)
    if not m:
        print("No resumed activity (screen off, or the shade/keyguard has focus?)", file=sys.stderr)
        sys.exit(1)
    print(f"{m.group(1)} (task {m.group(2)})")


def cmd_qs(args):
    if args.close:
        adb_check("shell", "cmd", "statusbar", "collapse")
        print("Collapsed Quick Settings")
        return
    adb_check("shell", "cmd", "statusbar", "expand-settings")
    # The request can land seconds late (e.g. just after an app-to-home transition), and a
    # dump taken before then is still the app underneath. Wait for the shade to take focus,
    # then for its expand animation, so a following find/tap sees the tiles in place.
    deadline = time.time() + args.timeout
    while not shade_focused():
        if time.time() > deadline:
            print(f"Quick Settings didn't take focus within {args.timeout}s", file=sys.stderr)
            sys.exit(1)
        time.sleep(0.2)
    time.sleep(args.settle)
    print("Expanded Quick Settings")


def shade_focused():
    out = adb_check("shell", "dumpsys", "window").stdout
    m = re.search(r"mCurrentFocus=(.*)", out)
    return bool(m and "NotificationShade" in m.group(1))


def cmd_list(args):
    root = dump_ui_tree(raw=args.raw)
    def walk(elem, depth=0):
        indent = "  " * depth
        text = elem.get("text", "")
        desc = elem.get("content-desc", "")
        cls = elem.get("class", "")
        res_id = elem.get("resource-id", "")
        bounds = elem.get("bounds", "")

        parts = [cls.split(".")[-1] if cls else "?"]
        if text:
            parts.append(f'text="{text}"')
        if desc:
            parts.append(f'desc="{desc}"')
        if res_id:
            parts.append(f'id="{res_id}"')
        if bounds:
            b = parse_bounds(bounds)
            if b:
                parts.append(f"center=({b[4]},{b[5]})")
        print(f"{indent}{' '.join(parts)}")
        for child in elem:
            walk(child, depth + 1)
    walk(root)


# ── Argument parsing ─────────────────────────────────────────────────


RAW_HELP = ("Report unconverted uiautomator (logical) bounds instead of physical display "
            "pixels; only differs on a Spatial Simulator, where the logical coordinates "
            "are not tappable")


def main():
    global _serial
    if sys.argv[1:2] == ["--mouse-daemon"]:
        mouse_daemon(sys.argv[2])
        return
    parser = argparse.ArgumentParser(prog="emu", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-s", "--serial", help="Target device serial (passed to adb -s; defaults to $ANDROID_SERIAL)")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("screenshot", help="Capture screenshot")
    p.add_argument("path", nargs="?", default="screenshot.png")

    p = sub.add_parser("find", help="Find UI elements by text/desc")
    p.add_argument("text", help="Substring to match (case-insensitive)")
    p.add_argument("--raw", action="store_true", help=RAW_HELP)

    p = sub.add_parser("tap", help="Tap UI element by text/desc")
    p.add_argument("text", help="Substring to match (must be unique)")

    p = sub.add_parser("tap-xy", help="Tap at coordinates")
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)

    p = sub.add_parser("hover", help="Park a hovering pointer over an element or coordinate")
    p.add_argument("target", nargs="?", help="Substring to match (must be unique), or an x coordinate")
    p.add_argument("y", type=int, nargs="?", help="y coordinate, when target is an x coordinate")
    p.add_argument("--hold", type=float, default=30.0,
                   help="Seconds to keep hovering before releasing (default 30)")
    p.add_argument("--shot", metavar="PATH",
                   help="Capture a screenshot while hovering (the pointer sprite auto-hides "
                        "after a few idle seconds, so a separate screenshot may miss it)")
    p.add_argument("--clear", action="store_true", help="Release a pointer left by an earlier hover")

    p = sub.add_parser("mouse", help="Drive a virtual USB mouse (pointer icons, right-click, wheel)")
    p.add_argument("--clear", action="store_true", help="Unregister the mouse (same as `mouse stop`)")
    msub = p.add_subparsers(dest="action")
    shot_help = "Capture a screenshot afterwards (the pointer stays parked and is drawn in it)"

    m = msub.add_parser("move", help="Park the pointer over an element or coordinate",
                        usage="emu mouse move (TEXT | X Y) [--shot PATH]")
    m.add_argument("target", help="Substring to match (must be unique), or an x coordinate")
    m.add_argument("y", type=int, nargs="?", help="y coordinate, when target is an x coordinate")
    m.add_argument("--shot", metavar="PATH", help=shot_help)

    m = msub.add_parser("click", help="Move there and click",
                        usage="emu mouse click (TEXT | X Y) [--right | --middle] [--double] [--shot PATH]")
    m.add_argument("target", help="Substring to match (must be unique), or an x coordinate")
    m.add_argument("y", type=int, nargs="?", help="y coordinate, when target is an x coordinate")
    button = m.add_mutually_exclusive_group()
    button.add_argument("--right", action="store_true", help="Secondary (right) button")
    button.add_argument("--middle", action="store_true", help="Middle button")
    m.add_argument("--double", action="store_true", help="Double-click")
    m.add_argument("--shot", metavar="PATH", help=shot_help)

    m = msub.add_parser("scroll", help="Turn the wheel (left/right use the horizontal wheel)",
                        usage="emu mouse scroll {up,down,left,right} [N] [--at TEXT | --at X Y] [--shot PATH]")
    m.add_argument("direction", choices=["up", "down", "left", "right"])
    m.add_argument("n", type=int, nargs="?", default=3, help="Wheel notches (default 3)")
    m.add_argument("--at", nargs="+", metavar="TEXT|X Y",
                   help="Move the pointer here first (default: wherever it is)")
    m.add_argument("--shot", metavar="PATH", help=shot_help)

    m = msub.add_parser("drag", help="Left-button drag between coordinates")
    for name in ("x1", "y1", "x2", "y2"):
        m.add_argument(name, type=int)
    m.add_argument("--steps", type=int, default=8, help="Intermediate moves (default 8)")
    m.add_argument("--shot", metavar="PATH", help=shot_help)

    msub.add_parser("pos", help="Print the pointer position")
    msub.add_parser("cursor", help="Print the pointer icon type (HAND, TEXT, ARROW, …)")
    msub.add_parser("stop", help="Unregister the mouse")

    p = sub.add_parser("key", help="Press keys or combos: tab, esc, ctrl+f, shift+tab, meta+slash")
    p.add_argument("combos", nargs="+", metavar="COMBO",
                   help="Key names joined by +, pressed in order (e.g. `key tab tab enter`)")

    p = sub.add_parser("logcat", help="Show recent logcat")
    p.add_argument("--tag", "-t", help="Filter by tag")
    p.add_argument("--grep", "-g", help="Filter lines by substring")
    p.add_argument("-n", type=int, default=50, help="Number of lines (default 50)")

    p = sub.add_parser("back", help="Press BACK key")

    p = sub.add_parser("launch", help="Force-stop + start activity")
    p.add_argument("component", help="package/activity")

    p = sub.add_parser("swipe", help="Swipe home screen page")
    p.add_argument("direction", choices=["left", "right"], help="Swipe direction")

    p = sub.add_parser("swipe-xy", help="Swipe between coordinates")
    p.add_argument("x1", type=int)
    p.add_argument("y1", type=int)
    p.add_argument("x2", type=int)
    p.add_argument("y2", type=int)
    p.add_argument("ms", type=int, nargs="?", default=200, help="Duration in ms (default 200)")

    p = sub.add_parser("long-press", help="Long press an element (by text/desc) or coordinates",
                       usage="emu long-press (TEXT | X Y) [MS]")
    p.add_argument("target", help="Substring to match (must be unique), or an x coordinate")
    p.add_argument("rest", nargs="*", metavar="Y/MS",
                   help="y (when target is x), then optional duration in ms (default 2000)")

    sub.add_parser("top", help="Print the resumed activity and its task")

    p = sub.add_parser("qs", help="Expand the Quick Settings panel")
    p.add_argument("--close", action="store_true", help="Collapse the shade instead")
    p.add_argument("--timeout", type=float, default=5.0,
                   help="Seconds to wait for the shade to take focus (default 5)")
    p.add_argument("--settle", type=float, default=0.5,
                   help="Seconds to wait after that for the expand animation (default 0.5)")

    p = sub.add_parser("list", help="Dump UI hierarchy tree")
    p.add_argument("--raw", action="store_true", help=RAW_HELP)

    args = parser.parse_args()
    # Explicit -s wins; otherwise fall back to $ANDROID_SERIAL so emu targets the
    # same device as adb and Gradle (which read it natively).
    _serial = args.serial or os.environ.get("ANDROID_SERIAL")
    if not args.command:
        parser.print_help()
        sys.exit(1)

    handlers = {
        "screenshot": cmd_screenshot,
        "find": cmd_find,
        "tap": cmd_tap,
        "tap-xy": cmd_tap_xy,
        "hover": cmd_hover,
        "mouse": cmd_mouse,
        "key": cmd_key,
        "logcat": cmd_logcat,
        "back": cmd_back,
        "launch": cmd_launch,
        "swipe": cmd_swipe,
        "swipe-xy": cmd_swipe_xy,
        "long-press": cmd_long_press,
        "top": cmd_top,
        "qs": cmd_qs,
        "list": cmd_list,
    }
    handlers[args.command](args)


if __name__ == "__main__":
    main()
